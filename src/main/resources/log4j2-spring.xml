<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %-5level [%t] %logger{36} [correlationId=%X{correlationId} traceId=%X{traceId} spanId=%X{spanId}] %msg%n%throwable"/>
        </Console>
    </Appenders>
    <Loggers>
        <Logger name="com.ledger" level="${env:LEDGER_LOG_LEVEL:-INFO}"/>
        <Root level="INFO"><AppenderRef ref="Console"/></Root>
    </Loggers>
</Configuration>
